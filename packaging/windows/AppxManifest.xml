<?xml version="1.0" encoding="utf-8"?>
<!-- The Store package. packaging/windows/build-msix.ps1 fills in the $...$ values.
     File types: the same as system::groups() (a test checks). Plain .zip, .rar, .7z, .tar, .pdf and
     .epub stay out: listing them makes Windows ask which app to use for all of them, even with
     desktop2:AllowSilentDefaultTakeOver. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="$Name$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="$Arch$" />
  <Properties>
    <DisplayName>TelescopeView</DisplayName>
    <PublisherDisplayName>$PublisherName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="App" Executable="TelescopeView.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TelescopeView"
        Description="Fast picture, video and comic viewer"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="image">
            <uap:DisplayName>Image (TelescopeView)</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.apng</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.jpe</uap:FileType>
              <uap:FileType>.jfif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.dib</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.cur</uap:FileType>
              <uap:FileType>.tga</uap:FileType>
              <uap:FileType>.qoi</uap:FileType>
              <uap:FileType>.pnm</uap:FileType>
              <uap:FileType>.pbm</uap:FileType>
              <uap:FileType>.pgm</uap:FileType>
              <uap:FileType>.ppm</uap:FileType>
              <uap:FileType>.pam</uap:FileType>
              <uap:FileType>.hdr</uap:FileType>
              <uap:FileType>.exr</uap:FileType>
              <uap:FileType>.dds</uap:FileType>
              <uap:FileType>.ff</uap:FileType>
              <uap:FileType>.jxl</uap:FileType>
              <uap:FileType>.svg</uap:FileType>
              <uap:FileType>.svgz</uap:FileType>
              <uap:FileType>.psd</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.hif</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.jxr</uap:FileType>
              <uap:FileType>.wdp</uap:FileType>
              <uap:FileType>.hdp</uap:FileType>
              <uap:FileType>.dng</uap:FileType>
              <uap:FileType>.cr2</uap:FileType>
              <uap:FileType>.cr3</uap:FileType>
              <uap:FileType>.crw</uap:FileType>
              <uap:FileType>.nef</uap:FileType>
              <uap:FileType>.nrw</uap:FileType>
              <uap:FileType>.arw</uap:FileType>
              <uap:FileType>.srf</uap:FileType>
              <uap:FileType>.sr2</uap:FileType>
              <uap:FileType>.orf</uap:FileType>
              <uap:FileType>.rw2</uap:FileType>
              <uap:FileType>.raf</uap:FileType>
              <uap:FileType>.pef</uap:FileType>
              <uap:FileType>.srw</uap:FileType>
              <uap:FileType>.erf</uap:FileType>
              <uap:FileType>.kdc</uap:FileType>
              <uap:FileType>.dcr</uap:FileType>
              <uap:FileType>.mrw</uap:FileType>
              <uap:FileType>.3fr</uap:FileType>
              <uap:FileType>.mef</uap:FileType>
              <uap:FileType>.mos</uap:FileType>
              <uap:FileType>.x3f</uap:FileType>
              <uap:FileType>.rwl</uap:FileType>
              <uap:FileType>.iiq</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="video">
            <uap:DisplayName>Video (TelescopeView)</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
              <uap:FileType>.flv</uap:FileType>
              <uap:FileType>.mpg</uap:FileType>
              <uap:FileType>.mpeg</uap:FileType>
              <uap:FileType>.m2v</uap:FileType>
              <uap:FileType>.ts</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
              <uap:FileType>.3g2</uap:FileType>
              <uap:FileType>.ogv</uap:FileType>
              <uap:FileType>.vob</uap:FileType>
              <uap:FileType>.asf</uap:FileType>
              <uap:FileType>.rm</uap:FileType>
              <uap:FileType>.rmvb</uap:FileType>
              <uap:FileType>.divx</uap:FileType>
              <uap:FileType>.f4v</uap:FileType>
              <uap:FileType>.mxf</uap:FileType>
              <uap:FileType>.y4m</uap:FileType>
              <uap:FileType>.hevc</uap:FileType>
              <uap:FileType>.h265</uap:FileType>
              <uap:FileType>.265</uap:FileType>
              <uap:FileType>.h264</uap:FileType>
              <uap:FileType>.264</uap:FileType>
              <uap:FileType>.avc</uap:FileType>
              <uap:FileType>.ivf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="comic">
            <uap:DisplayName>Comic (TelescopeView)</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.cbz</uap:FileType>
              <uap:FileType>.cbr</uap:FileType>
              <uap:FileType>.cb7</uap:FileType>
              <uap:FileType>.cbt</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="bookmark">
            <uap:DisplayName>TelescopeView bookmark</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.tvmark</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
